rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can read and write only their own study hub.
    // Version 1 keeps using Realtime Database at /counsellingStudyToolkit.
    // Do not point version 1 at these Firestore paths.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
